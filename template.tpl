/**
 * OpenAI ChatGPT Ads Event
 * Sends oaiq('measure', ...) conversion events via the OpenAI Ads Measurement Pixel.
 */
const copyFromWindow = require('copyFromWindow');
const logToConsole = require('logToConsole');

const OAIQ_MISSING_MESSAGE =
  'Backona - backona.com: OpenAI ChatGPT Ads Event failed - oaiq is not available.\n' +
  'Add the Backona - backona.com: OpenAI ChatGPT Ads Configuration tag with trigger Initialization — All Pages first.';
const MEASURE_PREVIEW_PREFIX =
  'Backona - backona.com: OpenAI ChatGPT Ads Event — oaiq("measure", ...) payload (GTM preview)';

const EVENT_DATA_TYPES = {
  page_viewed: 'contents',
  contents_viewed: 'contents',
  items_added: 'contents',
  checkout_started: 'contents',
  order_created: 'contents',
  lead_created: 'customer_action',
  registration_completed: 'customer_action',
  appointment_scheduled: 'customer_action',
  subscription_created: 'plan_enrollment',
  trial_started: 'plan_enrollment',
  custom: 'custom'
};

const EVENTS_WITHOUT_VALUE = {
  lead_created: true,
  registration_completed: true
};

const EVENTS_WITH_PLAN_ID = {
  subscription_created: true,
  trial_started: true,
  custom: true
};

const EVENTS_WITH_CONTENTS = {
  page_viewed: true,
  contents_viewed: true,
  items_added: true,
  checkout_started: true,
  order_created: true,
  custom: true
};

const eventAllowsValue = function(name) {
  return !EVENTS_WITHOUT_VALUE[name];
};

const eventAllowsPlanId = function(name) {
  return !!EVENTS_WITH_PLAN_ID[name];
};

const eventAllowsContents = function(name) {
  return !!EVENTS_WITH_CONTENTS[name];
};

const isWhitespaceChar = function(ch) {
  return ch === ' ' || ch === '\t' || ch === '\n' || ch === '\r';
};

const trimValue = function(value) {
  if (value === null || value === undefined) {
    return '';
  }
  const text = value + '';
  if (text === '') {
    return '';
  }
  let start = 0;
  let end = text.length - 1;
  while (start <= end && isWhitespaceChar(text[start])) {
    start = start + 1;
  }
  while (end >= start && isWhitespaceChar(text[end])) {
    end = end - 1;
  }
  if (start > end) {
    return '';
  }
  return text.substring(start, end + 1);
};

const isDigitsOnly = function(text) {
  if (text === '') {
    return false;
  }
  let index = 0;
  while (index < text.length) {
    const ch = text.charAt(index);
    if (ch < '0' || ch > '9') {
      return false;
    }
    index = index + 1;
  }
  return true;
};

const digitValue = function(ch) {
  if (ch === '0') {
    return 0;
  }
  if (ch === '1') {
    return 1;
  }
  if (ch === '2') {
    return 2;
  }
  if (ch === '3') {
    return 3;
  }
  if (ch === '4') {
    return 4;
  }
  if (ch === '5') {
    return 5;
  }
  if (ch === '6') {
    return 6;
  }
  if (ch === '7') {
    return 7;
  }
  if (ch === '8') {
    return 8;
  }
  if (ch === '9') {
    return 9;
  }
  return undefined;
};

const parseDigitsToInteger = function(text) {
  let result = 0;
  let index = 0;
  while (index < text.length) {
    result = result * 10 + digitValue(text[index]);
    index = index + 1;
  }
  return result;
};

const parsePositiveInteger = function(value) {
  const text = trimValue(value);
  if (text === '') {
    return null;
  }
  if (!isDigitsOnly(text)) {
    return undefined;
  }
  return parseDigitsToInteger(text);
};

const priceToMinorUnits = function(value) {
  if (value === null || value === undefined) {
    return null;
  }
  const text = trimValue(value);
  if (text === '') {
    return null;
  }
  let dotIndex = -1;
  let index = 0;
  while (index < text.length) {
    const ch = text.charAt(index);
    if (ch === '.') {
      dotIndex = index;
      break;
    }
    if (ch < '0' || ch > '9') {
      return undefined;
    }
    index = index + 1;
  }
  if (dotIndex === -1) {
    if (!isDigitsOnly(text)) {
      return undefined;
    }
    return parseDigitsToInteger(text) * 100;
  }
  const wholePart = text.substring(0, dotIndex);
  let fracPart = text.substring(dotIndex + 1);
  if (wholePart !== '' && !isDigitsOnly(wholePart)) {
    return undefined;
  }
  if (fracPart === '') {
    fracPart = '0';
  }
  while (fracPart.length < 2) {
    fracPart = fracPart + '0';
  }
  if (fracPart.length > 2) {
    fracPart = fracPart.substring(0, 2);
  }
  if (!isDigitsOnly(fracPart)) {
    return undefined;
  }
  const whole = wholePart === '' ? 0 : parseDigitsToInteger(wholePart);
  const frac = parseDigitsToInteger(fracPart);
  return whole * 100 + frac;
};

const resolveEventAmount = function(amountText, multiplyBy100) {
  if (multiplyBy100 === true) {
    return priceToMinorUnits(amountText);
  }
  return parsePositiveInteger(amountText);
};

const pickFirstNonEmpty = function(primary, fallback) {
  const primaryValue = trimValue(primary);
  if (primaryValue !== '') {
    return primaryValue;
  }
  return trimValue(fallback);
};

const buildContentRow = function(row, eventCurrency) {
  const item = {};
  let hasField = false;

  const id = trimValue(row.id);
  if (id !== '') {
    item.id = id;
    hasField = true;
  }

  const name = trimValue(row.name);
  if (name !== '') {
    item.name = name;
    hasField = true;
  }

  const contentType = trimValue(row.content_type);
  if (contentType !== '') {
    item.content_type = contentType;
    hasField = true;
  }

  const quantityText = trimValue(row.quantity);
  if (quantityText !== '') {
    const quantity = parsePositiveInteger(quantityText);
    if (quantity === undefined) {
      return undefined;
    }
    item.quantity = quantity;
    hasField = true;
  }

  const amountText = trimValue(row.amount);
  if (amountText !== '') {
    const amount = parsePositiveInteger(amountText);
    if (amount === undefined) {
      return undefined;
    }
    item.amount = amount;
    hasField = true;
  }

  const itemCurrency = trimValue(row.currency);
  if (itemCurrency !== '') {
    item.currency = itemCurrency;
    hasField = true;
  } else if (item.amount !== undefined && eventCurrency !== '') {
    item.currency = eventCurrency;
  }

  if (!hasField) {
    return null;
  }

  return item;
};

const buildContents = function(rows, eventCurrency) {
  if (!rows || rows.length === 0) {
    return null;
  }

  const contents = [];
  let index = 0;
  while (index < rows.length) {
    const built = buildContentRow(rows[index], eventCurrency);
    if (built === undefined) {
      return undefined;
    }
    if (built !== null) {
      contents.push(built);
    }
    index = index + 1;
  }

  if (contents.length === 0) {
    return null;
  }

  return contents;
};

const isContentItemObject = function(value) {
  if (value === null || value === undefined) {
    return false;
  }
  return value.id !== undefined || value.name !== undefined || value.content_type !== undefined ||
    value.quantity !== undefined || value.amount !== undefined || value.currency !== undefined;
};

const isContentsArray = function(value) {
  if (value === null || value === undefined || value.length === undefined) {
    return false;
  }
  if (value.length === 0) {
    return true;
  }
  return isContentItemObject(value[0]);
};

const parseContentsInput = function(raw, eventCurrency) {
  if (raw === null || raw === undefined) {
    return null;
  }
  if (!isContentsArray(raw)) {
    return undefined;
  }
  return buildContents(raw, eventCurrency);
};

const isGa4ItemObject = function(value) {
  if (value === null || value === undefined) {
    return false;
  }
  return value.item_id !== undefined || value.item_name !== undefined || value.price !== undefined;
};

const isGa4ItemsArray = function(value) {
  if (value === null || value === undefined || value.length === undefined) {
    return false;
  }
  if (value.length === 0) {
    return true;
  }
  return isGa4ItemObject(value[0]);
};

const mapGa4ItemRow = function(row, eventCurrency, defaultContentType) {
  const mapped = {
    id: pickFirstNonEmpty(row.item_id, row.id),
    name: pickFirstNonEmpty(row.item_name, row.name),
    content_type: defaultContentType
  };
  const quantity = parsePositiveInteger(row.quantity);
  if (quantity === undefined) {
    return undefined;
  }
  if (quantity !== null) {
    mapped.quantity = quantity;
  }
  const minorAmount = priceToMinorUnits(row.price);
  if (minorAmount === undefined) {
    return undefined;
  }
  if (minorAmount !== null) {
    mapped.amount = minorAmount;
  }
  const itemCurrency = trimValue(row.currency);
  if (itemCurrency !== '') {
    mapped.currency = itemCurrency;
  }
  return mapped;
};

const mapGa4ItemsInput = function(raw, eventCurrency, defaultContentType) {
  if (raw === null || raw === undefined) {
    return null;
  }
  if (!isGa4ItemsArray(raw)) {
    return undefined;
  }
  if (raw.length === 0) {
    return null;
  }
  const mappedRows = [];
  let index = 0;
  while (index < raw.length) {
    const mapped = mapGa4ItemRow(raw[index], eventCurrency, defaultContentType);
    if (mapped === undefined) {
      return undefined;
    }
    mappedRows.push(mapped);
    index = index + 1;
  }
  return buildContents(mappedRows, eventCurrency);
};

const logMeasurePreview = function(measureName, eventData, options, hasOptions) {
  if (data.debug !== true) {
    return;
  }
  const preview = {
    measure: measureName,
    eventData: eventData
  };
  if (hasOptions) {
    preview.options = options;
  }
  logToConsole(MEASURE_PREVIEW_PREFIX);
  logToConsole(preview);
};

const resolveContents = function(eventCurrency) {
  const contentsSource = trimValue(data.contentsSource);
  if (contentsSource === 'ga4_items') {
    const contentType = trimValue(data.ga4ContentType);
    const defaultContentType = contentType === '' ? 'product' : contentType;
    return mapGa4ItemsInput(data.ga4Items, eventCurrency, defaultContentType);
  }
  return parseContentsInput(data.contents, eventCurrency);
};

const eventName = trimValue(data.eventName);

if (!eventName || !EVENT_DATA_TYPES[eventName]) {
  data.gtmOnFailure();
  return;
}

if (eventName === 'custom' && trimValue(data.customEventName) === '') {
  data.gtmOnFailure();
  return;
}

const oaiq = copyFromWindow('oaiq');
if (!oaiq) {
  logToConsole(OAIQ_MISSING_MESSAGE);
  data.gtmOnFailure();
  return;
}

const eventData = {
  type: EVENT_DATA_TYPES[eventName]
};

const currency = trimValue(data.currency);
const amountText = trimValue(data.amount);

if (eventAllowsValue(eventName) && amountText !== '') {
  const amount = resolveEventAmount(amountText, data.amountMultiplyBy100 === true);
  if (amount === undefined) {
    data.gtmOnFailure();
    return;
  }
  if (currency === '') {
    data.gtmOnFailure();
    return;
  }
  eventData.amount = amount;
  eventData.currency = currency;
}

const planId = pickFirstNonEmpty(
  pickFirstNonEmpty(data.planIdSubscription, data.planIdTrial),
  pickFirstNonEmpty(data.planIdCustom, data.planId)
);
if (eventAllowsPlanId(eventName) && planId !== '') {
  eventData.plan_id = planId;
}

if (eventAllowsContents(eventName)) {
  const contents = resolveContents(currency);
  if (contents === undefined) {
    data.gtmOnFailure();
    return;
  }
  if (contents !== null) {
    eventData.contents = contents;
  }
}

const options = {};
const eventId = trimValue(data.eventId);
if (eventId !== '') {
  options.event_id = eventId;
}

if (eventName === 'custom') {
  options.custom_event_name = trimValue(data.customEventName);
}

if (data.optOut === true) {
  options.opt_out = true;
}

const measureName = eventName === 'custom' ? 'custom' : eventName;
const hasOptions = options.event_id || options.custom_event_name || options.opt_out === true;

if (hasOptions) {
  oaiq('measure', measureName, eventData, options);
} else {
  oaiq('measure', measureName, eventData);
}

logMeasurePreview(measureName, eventData, options, hasOptions);
data.gtmOnSuccess();


